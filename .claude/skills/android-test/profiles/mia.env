# Profile for sparesparrow/mia (apps/android). Device-test APKs use the isolated debug application id.
PKG=cz.mia.app.debug
MAIN_ACTIVITY=.MainActivity
REPO=sparesparrow/mia
CI_WORKFLOW=android-test.yml     # successful workflow runs carry both APKs in the device-apks artifact
TABS="Dashboard Camera Voice LED More"
# Verified on moto g54 (Android 15): Dashboard shows "No telemetry data" without an OBD adapter.
scenario_dashboard() {
  local r=0
  ui_launch && ui_wait "Dashboard" 12 && ui_has "Citro" || r=1
  ui_shot dashboard || true
  return $r
}
