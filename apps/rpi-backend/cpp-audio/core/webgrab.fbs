/*
 * MIA Protocol Schema - FlatBuffers Message Protocol
 *
 * This schema defines the complete message protocol for the MIA (AI Service with MCP and Hardware Control) system.
 * It supports multiple transport mechanisms (TCP, MQTT, WebSockets) and provides a unified interface
 * for voice control, AI interactions, hardware management, and system monitoring.
 *
 * Key Features:
 * - Strongly typed messages with efficient binary serialization
 * - Union types for polymorphic message handling
 * - Extensible design for future enhancements
 * - Multi-transport support (MQTT, TCP, etc.)
 * - Session management for conversational AI
 * - Hardware abstraction layer
 *
 * Transport Layers:
 * - MQTT: For pub/sub communication between services
 * - TCP: For direct client-server communication
 * - WebSockets: For web-based interfaces
 * - FlatBuffers: For efficient serialization/deserialization
 *
 * Message Flow:
 * 1. Client sends Request (via any transport)
 * 2. Server processes and sends Response
 * 3. Optional: Async events via MQTT subscriptions
 */

namespace Mia.Protocol;

table DownloadRequest {
  url:string (id: 0);
}

table DownloadResponse {
  session_id:uint32 (id: 0);
}

table DownloadStatusRequest {
  session_id:uint32 (id: 0);
}

table DownloadStatusResponse {
  status:string (id: 0);
}

table DownloadAbortRequest {
  session_id:uint32 (id: 0);
}

table ShutdownRequest {
}

// GPIO Control Messages
table GPIOConfigureRequest {
  pin:int32 (id: 0);
  direction:string (id: 1); // "input" or "output"
}

table GPIOSetRequest {
  pin:int32 (id: 0);
  value:bool (id: 1);
}

table GPIOGetRequest {
  pin:int32 (id: 0);
}

table GPIOStatusRequest {
}

table GPIOConfigureResponse {
  pin:int32 (id: 0);
  success:bool (id: 1);
}

table GPIOSetResponse {
  pin:int32 (id: 0);
  success:bool (id: 1);
}

table GPIOGetResponse {
  pin:int32 (id: 0);
  value:bool (id: 1);
  success:bool (id: 2);
}

table GPIOStatusResponse {
  pins:[GPIOPinStatus] (id: 0);
}

table GPIOPinStatus {
  pin:int32 (id: 0);
  direction:string (id: 1);
  value:bool (id: 2);
}

// Voice Control Messages
table VoiceCommandRequest {
  command:string (id: 0);         // Voice command text
  confidence:float (id: 1);       // Recognition confidence (0.0-1.0)
  language:string (id: 2);        // Language code (e.g., "en-US")
  session_id:string (id: 3);      // Voice session identifier
}

table VoiceCommandResponse {
  response_text:string (id: 0);   // Text response to speak
  actions:[VoiceAction] (id: 1);  // Actions to execute
  session_id:string (id: 2);      // Voice session identifier
  status:string (id: 3);          // "success", "error", "processing"
}

table VoiceAction {
  action_type:string (id: 0);     // "gpio_set", "device_control", "system_command"
  target:string (id: 1);          // Target device/service
  parameters:[KeyValue] (id: 2);  // Action parameters
}

table KeyValue {
  key:string (id: 0);
  value:string (id: 1);
}

// Wake Word Detection
table WakeWordDetected {
  wake_word:string (id: 0);       // Detected wake word
  confidence:float (id: 1);       // Detection confidence
  timestamp:uint64 (id: 2);       // Detection timestamp
}

// Audio Processing Messages
table AudioProcessRequest {
  audio_data:[ubyte] (id: 0);     // Raw audio data
  format:string (id: 1);          // Audio format ("wav", "mp3", etc.)
  sample_rate:uint32 (id: 2);     // Sample rate in Hz
  channels:uint8 (id: 3);         // Number of channels
  session_id:string (id: 4);      // Processing session ID
}

table AudioProcessResponse {
  transcription:string (id: 0);   // Transcribed text
  confidence:float (id: 1);       // Transcription confidence
  language:string (id: 2);        // Detected language
  session_id:string (id: 3);      // Processing session ID
  status:string (id: 4);          // "success", "error"
}

// AI Agent Communication
table AIAgentRequest {
  agent_id:string (id: 0);        // Target AI agent identifier
  query:string (id: 1);           // User query or command
  context:string (id: 2);         // Conversation context
  parameters:[KeyValue] (id: 3);  // Additional parameters
  session_id:string (id: 4);      // Conversation session ID
}

table AIAgentResponse {
  agent_id:string (id: 0);        // Responding agent identifier
  response:string (id: 1);        // AI response text
  actions:[AIAgentAction] (id: 2); // Actions to execute
  confidence:float (id: 3);       // Response confidence
  session_id:string (id: 4);      // Conversation session ID
  status:string (id: 5);          // "success", "error", "processing"
}

table AIAgentAction {
  action_type:string (id: 0);     // "execute_command", "set_gpio", "send_message"
  priority:int8 (id: 1);          // Action priority (0-255, higher = more urgent)
  parameters:[KeyValue] (id: 2);  // Action parameters
  timeout_ms:uint32 (id: 3);      // Action timeout in milliseconds
}

// MCP (Model Context Protocol) Messages
table MCPToolCall {
  tool_name:string (id: 0);       // Tool/function name
  arguments:string (id: 1);       // JSON-encoded arguments
  call_id:string (id: 2);         // Unique call identifier
}

table MCPToolResult {
  call_id:string (id: 0);         // Matching call identifier
  result:string (id: 1);          // JSON-encoded result
  error:string (id: 2);           // Error message (empty if success)
  success:bool (id: 3);           // Operation success flag
}

table MCPMessage {
  message_type:string (id: 0);    // "tool_call", "tool_result", "notification"
  content:string (id: 1);         // Message content (JSON)
  session_id:string (id: 2);      // MCP session identifier
  timestamp:uint64 (id: 3);       // Message timestamp
}

// Hardware Control Extensions
table HardwareConfig {
  device_type:string (id: 0);     // "gpio", "i2c", "spi", "uart", "pwm", "adc"
  device_id:string (id: 1);       // Unique device identifier
  config:[KeyValue] (id: 2);      // Device-specific configuration
  auto_start:bool = true (id: 3); // Whether to start device automatically
}

table HardwareEvent {
  device_id:string (id: 0);       // Source device identifier
  event_type:string (id: 1);      // "interrupt", "status_change", "error", "data_ready"
  event_data:[KeyValue] (id: 2);  // Event-specific data
  timestamp:uint64 (id: 3);       // Event timestamp
  sequence_id:uint32 (id: 4);     // Sequence number for ordered events
}

// Streaming Audio Support
table AudioStreamStart {
  session_id:string (id: 0);      // Stream session identifier
  format:string (id: 1);          // Audio format
  sample_rate:uint32 (id: 2);     // Sample rate in Hz
  channels:uint8 (id: 3);         // Number of channels
  compression:string (id: 4);     // Compression type (optional)
}

table AudioStreamData {
  session_id:string (id: 0);      // Stream session identifier
  sequence_number:uint32 (id: 1); // Packet sequence number
  audio_data:[ubyte] (id: 2);     // Audio data chunk
  timestamp:uint64 (id: 3);       // Data timestamp
  end_of_stream:bool (id: 4);     // True for last packet
}

table AudioStreamStop {
  session_id:string (id: 0);      // Stream session identifier
  reason:string (id: 1);          // Stop reason ("completed", "error", "timeout")
}

// Video Streaming Support
table VideoStreamConfig {
  session_id:string (id: 0);      // Stream session identifier
  width:uint32 (id: 1);           // Video width in pixels
  height:uint32 (id: 2);          // Video height in pixels
  frame_rate:uint32 (id: 3);      // Target frame rate (fps)
  codec:string (id: 4);           // Video codec ("h264", "mjpeg", "vp8")
  bitrate_kbps:uint32 (id: 5);    // Target bitrate in kbps
  keyframe_interval:uint32 (id: 6); // Keyframe interval in frames
}

table VideoStreamStart {
  session_id:string (id: 0);      // Stream session identifier
  config:VideoStreamConfig (id: 1); // Video configuration
  camera_id:string (id: 2);       // Camera device identifier
}

table VideoStreamData {
  session_id:string (id: 0);      // Stream session identifier
  sequence_number:uint32 (id: 1); // Packet sequence number
  frame_number:uint32 (id: 2);    // Frame number in stream
  video_data:[ubyte] (id: 3);     // Encoded video frame data
  timestamp:uint64 (id: 4);       // Frame capture timestamp
  keyframe:bool (id: 5);          // Whether this is a keyframe
  end_of_stream:bool (id: 6);     // True for last packet
}

table VideoStreamStop {
  session_id:string (id: 0);      // Stream session identifier
  reason:string (id: 1);          // Stop reason ("completed", "error", "timeout", "camera_disconnected")
}

table VideoStreamStatus {
  session_id:string (id: 0);      // Stream session identifier
  status:string (id: 1);          // "active", "paused", "error"
  frames_sent:uint32 (id: 2);     // Total frames sent
  bytes_sent:uint64 (id: 3);      // Total bytes sent
  avg_fps:float (id: 4);          // Average frames per second
  error_message:string (id: 5);   // Error message if status is "error"
}

// Advanced AI Features
table AIContextUpdate {
  session_id:string (id: 0);      // Conversation session
  context_type:string (id: 1);    // "user_profile", "environment", "device_state"
  context_data:string (id: 2);    // JSON context data
  timestamp:uint64 (id: 3);       // Update timestamp
}

table AIMemoryQuery {
  session_id:string (id: 0);      // Session identifier
  query_type:string (id: 1);      // "recall", "search", "summarize"
  query:string (id: 2);           // Search/query string
  limit:uint32 = 10 (id: 3);     // Maximum results
}

table AIMemoryResult {
  session_id:string (id: 0);      // Session identifier
  results:[MemoryItem] (id: 1);   // Retrieved memories
  total_count:uint32 (id: 2);     // Total available results
}

table MemoryItem {
  id:string (id: 0);              // Memory item identifier
  content:string (id: 1);         // Memory content
  timestamp:uint64 (id: 2);       // When memory was created
  relevance_score:float (id: 3);  // Search relevance (0.0-1.0)
  metadata:[KeyValue] (id: 4);    // Additional metadata
}

// Service Discovery and Coordination
table ServiceAnnouncement {
  service_id:string (id: 0);      // Unique service identifier
  service_type:string (id: 1);    // "voice-control", "hardware-server", "ai-agent"
  capabilities:[string] (id: 2);  // Service capabilities
  endpoint:string (id: 3);        // Connection endpoint
  status:string (id: 4);          // "online", "busy", "offline"
  last_heartbeat:uint64 (id: 5);  // Last heartbeat timestamp
}

table ServiceQuery {
  service_type:string (id: 0);    // Type filter (optional)
  capability:string (id: 1);      // Capability filter (optional)
}

table ServiceList {
  services:[ServiceAnnouncement] (id: 0); // Available services
  query_timestamp:uint64 (id: 1); // When query was processed
}

// MQTT Transport Envelope
table MQTTMessage {
  topic:string (id: 0);
  payload:string (id: 1);  // JSON payload
  qos:int32 = 0 (id: 2);
  retain:bool = false (id: 3);
}

table ErrorResponse {
  error:string (id: 0);
}

// Enhanced unions for MQTT + legacy support
union Request {
  // Legacy requests
  DownloadRequest,
  DownloadStatusRequest,
  DownloadAbortRequest,
  ShutdownRequest,
  GPIOConfigureRequest,
  GPIOSetRequest,
  GPIOGetRequest,
  GPIOStatusRequest,
  SystemStatusRequest,
  DeviceDiscoveryRequest,
  TelemetryRequest,
  CommandAckRequest,
  HealthCheckRequest,

  // Voice control requests
  VoiceCommandRequest,
  AudioProcessRequest,
  AudioStreamStart,
  VideoStreamStart,
  VideoStreamConfig,

  // AI agent requests
  AIAgentRequest,
  AIContextUpdate,
  AIMemoryQuery,

  // MCP requests
  MCPToolCall,

  // Hardware extension requests
  HardwareConfig,

  // Service coordination requests
  ServiceQuery,

  // Security requests
  AuthenticationRequest,
  AuthorizationRequest,

  // Plugin system requests
  PluginLoadRequest,
  PluginUnloadRequest,

  // Configuration requests
  ConfigurationUpdate,

  // Event system requests
  EventSubscription,

  // Workflow requests
  WorkflowStartRequest,
  WorkflowControlRequest,

  // AI/ML requests
  ModelLoadRequest,
  InferenceRequest,

  // Coordination requests
  LockRequest,
  UnlockRequest
}

union Response {
  // Legacy responses
  DownloadResponse,
  DownloadStatusResponse,
  ErrorResponse,
  GPIOConfigureResponse,
  GPIOSetResponse,
  GPIOGetResponse,
  GPIOStatusResponse,
  SystemStatusResponse,
  DeviceDiscoveryResponse,
  TelemetryResponse,
  CommandAckResponse,
  HealthCheckResponse,

  // Voice control responses
  VoiceCommandResponse,
  AudioProcessResponse,
  AudioStreamStop,
  VideoStreamStop,
  VideoStreamStatus,

  // AI agent responses
  AIAgentResponse,
  AIMemoryResult,

  // MCP responses
  MCPToolResult,

  // Hardware extension responses
  HardwareEvent,

  // Service coordination responses
  ServiceList,

  // Security responses
  AuthenticationResponse,
  AuthorizationResponse,

  // Plugin system responses
  PluginLoadResponse,

  // Configuration responses
  ConfigurationSnapshot,

  // Monitoring responses
  MetricReport,
  HealthReport,

  // Event system responses
  EventAcknowledgment,

  // Workflow responses
  WorkflowStatusResponse,

  // AI/ML responses
  ModelLoadResponse,
  InferenceResponse,

  // Coordination responses
  LockResponse
}

table Message {
  request:Request (id: 1);
  response:Response (id: 3);
}

// System Status Messages
table SystemStatusRequest {
}

table SystemStatusResponse {
  uptime_seconds:uint64 (id: 0);
  memory_used_mb:uint32 (id: 1);
  memory_total_mb:uint32 (id: 2);
  cpu_usage_percent:float (id: 3);
  active_devices:uint32 (id: 4);
  timestamp:uint64 (id: 5);
}

// Device Management Messages
table DeviceDiscoveryRequest {
  device_type:string (id: 0);  // optional filter
}

table DeviceInfo {
  device_id:string (id: 0);
  device_type:string (id: 1);
  capabilities:[string] (id: 2);
  status:string (id: 3);  // "online", "offline", "error"
  last_seen:uint64 (id: 4);
  metadata:[DeviceMetadata] (id: 5);
}

table DeviceMetadata {
  key:string (id: 0);
  value:string (id: 1);
}

table DeviceDiscoveryResponse {
  devices:[DeviceInfo] (id: 0);
}

// Telemetry Messages
table TelemetryRequest {
  device_id:string (id: 0);  // optional specific device
  sensor_type:string (id: 1);  // optional filter
}

table SensorReading {
  sensor_id:string (id: 0);
  sensor_type:string (id: 1);
  value:float (id: 2);
  unit:string (id: 3);
  timestamp:uint64 (id: 4);
  metadata:[DeviceMetadata] (id: 5);
}

table TelemetryResponse {
  device_id:string (id: 0);
  readings:[SensorReading] (id: 1);
}

// Command Acknowledgment
table CommandAckRequest {
  command_id:string (id: 0);
}

table CommandAckResponse {
  command_id:string (id: 0);
  success:bool (id: 1);
  message:string (id: 2);
  timestamp:uint64 (id: 3);
}

// Service Health Messages
table HealthCheckRequest {
  service_name:string (id: 0);
}

table ServiceHealth {
  service_name:string (id: 0);
  status:string (id: 1);  // "healthy", "degraded", "unhealthy"
  uptime_seconds:uint64 (id: 2);
  last_check:uint64 (id: 3);
  error_message:string (id: 4);
}

table HealthCheckResponse {
  services:[ServiceHealth] (id: 0);
  overall_status:string (id: 1);
}

// MQTT-specific envelope for cross-process communication
table MQTTEnvelope {
  message_id:string (id: 0);
  timestamp:uint64 (id: 1);
  source:string (id: 2);     // "python-orchestrator", "cpp-hardware-server", etc.
  target:string (id: 3);     // target service identifier
  payload:Message (id: 4);   // the actual message content
}

// Root types for serialization
root_type DownloadRequest;
root_type DownloadResponse;
root_type DownloadStatusRequest;
root_type DownloadStatusResponse;
root_type DownloadAbortRequest;
root_type ShutdownRequest;
root_type ErrorResponse;
root_type Message;

// Additional root types for new messages
root_type SystemStatusRequest;
root_type SystemStatusResponse;
root_type DeviceDiscoveryRequest;
root_type DeviceDiscoveryResponse;
root_type TelemetryRequest;
root_type TelemetryResponse;
root_type CommandAckRequest;
root_type CommandAckResponse;
root_type HealthCheckRequest;
root_type HealthCheckResponse;

// Voice control root types
root_type VoiceCommandRequest;
root_type VoiceCommandResponse;
root_type WakeWordDetected;
root_type AudioProcessRequest;
root_type AudioProcessResponse;
root_type AudioStreamStart;
root_type AudioStreamData;
root_type AudioStreamStop;

// Video streaming root types
root_type VideoStreamConfig;
root_type VideoStreamStart;
root_type VideoStreamData;
root_type VideoStreamStop;
root_type VideoStreamStatus;

// AI agent root types
root_type AIAgentRequest;
root_type AIAgentResponse;
root_type AIContextUpdate;
root_type AIMemoryQuery;
root_type AIMemoryResult;

// MCP root types
root_type MCPToolCall;
root_type MCPToolResult;
root_type MCPMessage;

// Hardware extension root types
root_type HardwareConfig;
root_type HardwareEvent;

// Service coordination root types
root_type ServiceAnnouncement;
root_type ServiceQuery;
root_type ServiceList;

// Security and Authentication
table AuthenticationRequest {
  username:string (id: 0);
  password:string (id: 1);  // For basic auth, or token for token-based auth
  method:string (id: 2);    // "basic", "token", "oauth2", "certificate"
  client_id:string (id: 3); // For OAuth2/device flows
}

table AuthenticationResponse {
  success:bool (id: 0);
  token:string (id: 1);     // Access token for successful auth
  expires_at:uint64 (id: 2); // Token expiration timestamp
  user_id:string (id: 3);
  permissions:[string] (id: 4); // Granted permissions
  error_message:string (id: 5);
}

table AuthorizationRequest {
  token:string (id: 0);
  resource:string (id: 1);    // Resource being accessed
  action:string (id: 2);      // Action being performed ("read", "write", "execute")
  context:[KeyValue] (id: 3); // Additional context
}

table AuthorizationResponse {
  allowed:bool (id: 0);
  reason:string (id: 1);      // Reason for denial if not allowed
}

// Plugin and Extension System
table PluginLoadRequest {
  plugin_id:string (id: 0);
  plugin_version:string (id: 1);
  config:[KeyValue] (id: 2);  // Plugin-specific configuration
}

table PluginLoadResponse {
  plugin_id:string (id: 0);
  success:bool (id: 1);
  error_message:string (id: 2);
  capabilities:[string] (id: 3); // Plugin capabilities
}

table PluginUnloadRequest {
  plugin_id:string (id: 0);
}

table PluginMessage {
  plugin_id:string (id: 0);
  message_type:string (id: 1); // "event", "command", "response"
  payload:string (id: 2);      // JSON payload for plugin-specific data
}

// Advanced Configuration Management
table ConfigurationUpdate {
  component:string (id: 0);    // Component to configure
  section:string (id: 1);      // Configuration section
  key:string (id: 2);          // Configuration key
  value:string (id: 3);        // New value
  value_type:string (id: 4);   // "string", "int", "float", "bool", "json"
}

table ConfigurationSnapshot {
  component:string (id: 0);
  configuration:string (id: 1); // JSON representation of full config
  timestamp:uint64 (id: 2);
}

// Real-time Telemetry and Metrics
table MetricReport {
  metric_name:string (id: 0);
  metric_type:string (id: 1);   // "counter", "gauge", "histogram", "summary"
  value:float (id: 2);
  labels:[KeyValue] (id: 3);   // Metric labels/tags
  timestamp:uint64 (id: 4);
}

table HealthReport {
  component:string (id: 0);
  health_status:string (id: 1); // "healthy", "degraded", "unhealthy", "unknown"
  checks:[HealthCheck] (id: 2); // Individual health checks
  timestamp:uint64 (id: 3);
}

table HealthCheck {
  check_name:string (id: 0);
  status:string (id: 1);        // "pass", "fail", "warn"
  output:string (id: 2);        // Check output/details
  duration_ms:uint32 (id: 3);   // Check duration
}

// Event-Driven Architecture
table EventSubscription {
  event_type:string (id: 0);    // Event type to subscribe to
  filter:string (id: 1);        // Optional filter expression (JSON)
  subscription_id:string (id: 2); // Unique subscription identifier
}

table EventPublication {
  event_type:string (id: 0);
  event_id:string (id: 1);      // Unique event identifier
  payload:string (id: 2);       // Event payload (JSON)
  source:string (id: 3);        // Event source component
  timestamp:uint64 (id: 4);
  correlation_id:string (id: 5); // For request-response correlation
}

table EventAcknowledgment {
  event_id:string (id: 0);
  subscription_id:string (id: 1);
  success:bool (id: 2);
  error_message:string (id: 3);
}

// Workflow and Orchestration
table WorkflowStartRequest {
  workflow_id:string (id: 0);
  workflow_name:string (id: 1);
  parameters:[KeyValue] (id: 2);
  priority:int8 = 0 (id: 3);    // 0=normal, higher numbers = higher priority
}

table WorkflowStatusResponse {
  workflow_id:string (id: 0);
  status:string (id: 1);        // "running", "completed", "failed", "cancelled"
  progress_percent:float (id: 2);
  current_step:string (id: 3);
  steps_completed:uint32 (id: 4);
  total_steps:uint32 (id: 5);
  result:string (id: 6);        // JSON result for completed workflows
  error_message:string (id: 7);
}

table WorkflowControlRequest {
  workflow_id:string (id: 0);
  action:string (id: 1);        // "pause", "resume", "cancel", "restart"
}

// Advanced AI Features
table ModelLoadRequest {
  model_id:string (id: 0);
  model_type:string (id: 1);    // "llm", "embedding", "vision", "audio"
  model_path:string (id: 2);
  config:[KeyValue] (id: 3);    // Model-specific configuration
}

table ModelLoadResponse {
  model_id:string (id: 0);
  success:bool (id: 1);
  error_message:string (id: 2);
  model_info:string (id: 3);    // JSON model information
}

table InferenceRequest {
  model_id:string (id: 0);
  input_data:string (id: 1);    // JSON input data
  parameters:[KeyValue] (id: 2); // Inference parameters
  async:bool = false (id: 3);  // Whether to process asynchronously
}

table InferenceResponse {
  request_id:string (id: 0);
  model_id:string (id: 1);
  output_data:string (id: 2);   // JSON output data
  confidence_scores:[KeyValue] (id: 3); // Confidence scores for classifications
  processing_time_ms:uint32 (id: 4);
  error_message:string (id: 5);
}

// Distributed Coordination
table LockRequest {
  lock_key:string (id: 0);
  lock_type:string (id: 1);     // "exclusive", "shared"
  timeout_ms:uint32 (id: 2);    // Lock timeout
  owner_id:string (id: 3);      // Lock owner identifier
}

table LockResponse {
  lock_key:string (id: 0);
  acquired:bool (id: 1);
  lock_token:string (id: 2);    // Token for lock operations
  expires_at:uint64 (id: 3);
}

table UnlockRequest {
  lock_key:string (id: 0);
  lock_token:string (id: 1);
}

// Enhanced MQTT envelope
root_type MQTTEnvelope;

// Security root types
root_type AuthenticationRequest;
root_type AuthenticationResponse;
root_type AuthorizationRequest;
root_type AuthorizationResponse;

// Plugin system root types
root_type PluginLoadRequest;
root_type PluginLoadResponse;
root_type PluginUnloadRequest;
root_type PluginMessage;

// Configuration root types
root_type ConfigurationUpdate;
root_type ConfigurationSnapshot;

// Monitoring root types
root_type MetricReport;
root_type HealthReport;

// Event system root types
root_type EventSubscription;
root_type EventPublication;
root_type EventAcknowledgment;

// Workflow root types
root_type WorkflowStartRequest;
root_type WorkflowStatusResponse;
root_type WorkflowControlRequest;

// AI/ML root types
root_type ModelLoadRequest;
root_type ModelLoadResponse;
root_type InferenceRequest;
root_type InferenceResponse;

// Coordination root types
root_type LockRequest;
root_type LockResponse;
root_type UnlockRequest;
