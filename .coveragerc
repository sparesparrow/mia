# Coverage for the production Python code (component 2), measured by the tests in tests/ (component 3).
# Run: pytest tests/ -m "not hardware" --cov
[run]
source =
    apps/rpi-backend
    orchestration
    schemas
    tools
omit =
    */__pycache__/*
    schemas/generated/*

[report]
precision = 2
show_missing = True
skip_covered = False
