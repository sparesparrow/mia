namespace Mia;

// ============================================================================
// GPIO Control Messages
// ============================================================================

enum GPIODirection: byte { Input = 0, Output = 1, PWM = 2 }

table GPIOCommand {
  pin: int (id: 0);
  direction: GPIODirection (id: 1);
  value: bool (id: 2);
  timestamp: uint64 (id: 3);
}

table GPIOResponse {
  pin: int (id: 0);
  success: bool (id: 1);
  value: bool (id: 2);
  error_message: string (id: 3);
  timestamp: uint64 (id: 4);
}

// ============================================================================
// Sensor Telemetry Messages
// ============================================================================

enum SensorType: byte { Temperature = 0, Humidity = 1, Distance = 2, Pressure = 3, Light = 4, Motion = 5 }

table SensorTelemetry {
  sensor_id: string (id: 0);
  sensor_type: SensorType (id: 1);
  value: float (id: 2);
  unit: string (id: 3);
  timestamp: uint64 (id: 4);
  metadata: [ubyte] (id: 5);  // For additional sensor-specific data
}

// ============================================================================
// System Status Messages
// ============================================================================

table SystemStatus {
  uptime_seconds: uint64 (id: 0);
  memory_percent: float (id: 1);
  cpu_percent: float (id: 2);
  device_count: int (id: 3);
  timestamp: uint64 (id: 4);
}

// ============================================================================
// Command Acknowledgment Messages
// ============================================================================

enum CommandStatus: byte { Success = 0, Failure = 1, Timeout = 2, Invalid = 3 }

table CommandAck {
  command_id: string (id: 0);
  status: CommandStatus (id: 1);
  error_message: string (id: 2);
  response_data: [ubyte] (id: 3);  // Optional response payload
  timestamp: uint64 (id: 4);
}

// ============================================================================
// Device Management Messages
// ============================================================================

enum DeviceType: byte { GPIO = 0, Sensor = 1, Actuator = 2, Display = 3, Network = 4 }

table DeviceInfo {
  device_id: string (id: 0);
  device_type: DeviceType (id: 1);
  name: string (id: 2);
  capabilities: [string] (id: 3);
  status: string (id: 4);
  last_seen: uint64 (id: 5);
  metadata: [ubyte] (id: 6);
}

// ============================================================================
// LED Control Messages (for Phase 4.4)
// ============================================================================

enum LEDMode: byte { Drive = 0, Parked = 1, Night = 2, Service = 3, Emergency = 4 }

enum AIState: byte { Listening = 0, Speaking = 1, Thinking = 2, Recording = 3, Error = 4, Idle = 5 }

table LEDState {
  mode: LEDMode (id: 0);
  ai_state: AIState (id: 1);
  brightness: float (id: 2);  // 0.0 to 1.0
  service_status: [string] (id: 3);  // List of service names and their status
  obd_data: [ubyte] (id: 4);  // OBD telemetry data
  timestamp: uint64 (id: 5);
}

// ============================================================================
// Vehicle Telemetry (existing, expanded)
// ============================================================================

enum DpfStatus : byte { Normal = 0, Regenerating = 1, Warning = 2, Critical = 3 }

table VehicleTelemetry {
  // Engine data
  rpm: float (id: 0);
  speed_kmh: float (id: 1);
  coolant_temp_c: float (id: 2);
  oil_temperature_c: float (id: 3);
  battery_voltage: float (id: 4);

  // DPF data
  dpf_soot_load_percent: float (id: 5);
  dpf_soot_mass_g: float (id: 6);
  dpf_regeneration_status: DpfStatus (id: 7);
  eolys_additive_level_percent: float (id: 8);
  eolys_additive_level_l: float (id: 9);

  // Additional sensors
  intake_air_temp_c: float (id: 10);
  fuel_level_percent: float (id: 11);
  engine_load_percent: float (id: 12);

  timestamp: uint64 (id: 13);
}

// ============================================================================
// ESP32 BPM Detector - zero-overhead structs for ESP-NOW (250-byte limit)
// Note: structs have fixed layout, no field IDs needed
// Workaround for ESP-IDF conflict: #undef STRUCT_END before including
// ============================================================================

struct AudioFeatures {
  bpm: float;
  beat_confidence: float;
  dominant_freq: float;
  rms_energy: float;
  timestamp_ms: uint32;
}

struct BeatEvent {
  bpm: float;
  beat_confidence: float;
  beat_number: uint32;
  timestamp_ms: uint32;
}

// ============================================================================
// Root Types for Different Message Categories
// ============================================================================

root_type GPIOCommand;
root_type SensorTelemetry;
root_type SystemStatus;
root_type CommandAck;
root_type DeviceInfo;
root_type LEDState;
root_type VehicleTelemetry;
