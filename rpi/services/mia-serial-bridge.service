[Unit]
Description=MIA Serial Bridge - ESP32/Arduino to ZeroMQ
After=network.target zmq-broker.service
Wants=zmq-broker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/mia/rpi
ExecStart=/opt/mia/rpi/bin/python3 /opt/mia/rpi/hardware/serial_bridge.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment=PYTHONHOME=/opt/mia/rpi
Environment=PATH=/opt/mia/rpi/bin:/usr/bin:/usr/local/bin

[Install]
WantedBy=multi-user.target
