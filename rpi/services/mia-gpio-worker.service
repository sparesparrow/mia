[Unit]
Description=MIA GPIO Worker
After=network.target mia-broker.service
Requires=mia-broker.service

[Service]
Type=simple
User=mia
Group=mia
WorkingDirectory=/opt/mia/rpi/hardware
ExecStart=/opt/mia/rpi/bin/python3 gpio_worker.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment=PYTHONPATH=/opt/mia/rpi
Environment=PYTHONHOME=/opt/mia/rpi
Environment=PATH=/opt/mia/rpi/bin:/usr/bin:/usr/local/bin

[Install]
WantedBy=multi-user.target
