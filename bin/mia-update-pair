#!/usr/bin/env python3
"""Pair or unpair a phone for software updates (ADR-0023, REQ-UPD-004). Root only, on the Pi.

    sudo /opt/mia/bin/mia-update-pair add <label> '<public key line>'
    sudo /opt/mia/bin/mia-update-pair remove <label>
    sudo /opt/mia/bin/mia-update-pair list

A paired key can run `sudo /opt/mia/bin/mia-apply-update` as root over SSH, so pairing is an administrator action:
nothing the API or the phone can reach writes this list. It is /etc/mia/update_authorized_keys, owned by root, mode
644, read by sshd through AuthorizedKeysCommand (infra/deploy/rpi/install-update-access.sh). Only a bare ed25519 or
ECDSA key is accepted; the forced command and the restrictions are written by this tool, never taken from the key.
Python standard library only.
"""

from __future__ import annotations

import base64
import binascii
import fcntl
import hashlib
import os
import re
import struct
import sys
import tempfile
from pathlib import Path

DEFAULT_AUTHORIZED_KEYS = "/etc/mia/update_authorized_keys"
FORCED_COMMAND = "sudo /opt/mia/bin/mia-apply-update"
OPTIONS = (
    f'restrict,command="{FORCED_COMMAND}",no-pty,no-port-forwarding,no-agent-forwarding,no-X11-forwarding,no-user-rc'
)
KEY_TYPES = ("ssh-ed25519", "ecdsa-sha2-nistp256", "ecdsa-sha2-nistp384", "ecdsa-sha2-nistp521")
MAX_KEYS = 8
LABEL_RE = re.compile(r"^[A-Za-z0-9._-]{1,32}$")
_KEY_RE = re.compile(r"^(" + "|".join(re.escape(t) for t in KEY_TYPES) + r") ([A-Za-z0-9+/]{16,2048}={0,2})(?: \S.*)?$")


class PairError(Exception):
    pass


def keys_path() -> Path:
    return Path(os.environ.get("MIA_AUTHORIZED_KEYS", DEFAULT_AUTHORIZED_KEYS))


def _fields(blob: bytes) -> list:
    out, pos = [], 0
    while pos < len(blob):
        if pos + 4 > len(blob):
            raise PairError("the key body is truncated")
        (length,) = struct.unpack(">I", blob[pos:pos + 4])
        if pos + 4 + length > len(blob):
            raise PairError("the key body is truncated")
        out.append(blob[pos + 4:pos + 4 + length])
        pos += 4 + length
    return out


def parse_public_key(line: str):
    """Return (type, base64 body) of a single bare OpenSSH public key, or raise PairError."""
    if "\n" in line or "\r" in line or "\0" in line:
        raise PairError("the key must be one line")
    match = _KEY_RE.match(line.strip())
    if not match:
        raise PairError("not a plain ed25519 or ECDSA OpenSSH public key (type, base64 body, optional comment); options and RSA are refused")
    key_type, body = match.groups()
    try:
        fields = _fields(base64.b64decode(body, validate=True))
    except (binascii.Error, ValueError):
        raise PairError("the key body is not valid base64") from None
    if not fields or fields[0] != key_type.encode():
        raise PairError("the key body does not match its type")
    if key_type == "ssh-ed25519":
        if len(fields) != 2 or len(fields[1]) != 32:
            raise PairError("not a valid ed25519 public key")
    else:
        curve = key_type.rsplit("-", 1)[1].encode()
        size = {b"nistp256": 65, b"nistp384": 97, b"nistp521": 133}[curve]
        if len(fields) != 3 or fields[1] != curve or len(fields[2]) != size or fields[2][:1] != b"\x04":
            raise PairError("not a valid ECDSA public key")
    return key_type, body


def fingerprint(body: str) -> str:
    return "SHA256:" + base64.b64encode(hashlib.sha256(base64.b64decode(body)).digest()).decode().rstrip("=")


def read_entries(path: Path) -> list:
    entries = []
    if not path.exists():
        return entries
    for line in path.read_text(encoding="utf-8").splitlines():
        if not line.startswith(OPTIONS + " "):
            continue
        parts = line[len(OPTIONS) + 1:].split(" ")
        if len(parts) == 3 and parts[2].startswith("mia-phone:"):
            entries.append({"type": parts[0], "body": parts[1], "label": parts[2][len("mia-phone:"):]})
    return entries


def _chown_root(path: str) -> None:
    os.chown(path, 0, 0)


def write_entries(path: Path, entries: list) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    text = "".join(f"{OPTIONS} {e['type']} {e['body']} mia-phone:{e['label']}\n" for e in entries)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=".update_authorized_keys.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as out:
            out.write(text)
        _chown_root(tmp)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except OSError:
        Path(tmp).unlink(missing_ok=True)
        raise


def _locked(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    handle = open(str(path) + ".lock", "w")
    fcntl.flock(handle, fcntl.LOCK_EX)
    return handle


def add(path: Path, label: str, public_key: str) -> str:
    if not LABEL_RE.match(label):
        raise PairError("label must be 1-32 characters of A-Z a-z 0-9 . _ -")
    key_type, body = parse_public_key(public_key)
    with _locked(path):
        entries = read_entries(path)
        same = [e for e in entries if e["body"] == body and e["type"] == key_type]
        if same and same[0]["label"] == label:
            return f"already paired: {label} {fingerprint(body)}"
        entries = [e for e in entries if e not in same and e["label"] != label]
        if len(entries) >= MAX_KEYS:
            raise PairError(f"at most {MAX_KEYS} phones can be paired; remove one first")
        entries.append({"type": key_type, "body": body, "label": label})
        write_entries(path, entries)
    return f"paired: {label} {fingerprint(body)}"


def remove(path: Path, label: str) -> str:
    if not LABEL_RE.match(label):
        raise PairError("bad label")
    with _locked(path):
        entries = read_entries(path)
        kept = [e for e in entries if e["label"] != label]
        if len(kept) == len(entries):
            raise PairError("no such phone")
        write_entries(path, kept)
    return f"removed: {label}"


def main(argv: list) -> int:
    if os.geteuid() != 0:
        print("mia-update-pair: must run as root (sudo); a paired key can update the Pi as root", file=sys.stderr)
        return 1
    path = keys_path()
    try:
        if argv == ["list"]:
            for e in read_entries(path):
                print(f"{e['label']} {fingerprint(e['body'])}")
            return 0
        if len(argv) == 3 and argv[0] == "add":
            print(add(path, argv[1], argv[2]))
            return 0
        if len(argv) == 2 and argv[0] == "remove":
            print(remove(path, argv[1]))
            return 0
    except PairError as exc:
        print(f"mia-update-pair: {exc}", file=sys.stderr)
        return 1
    except OSError as exc:
        print(f"mia-update-pair: cannot write {path}: {exc.__class__.__name__}", file=sys.stderr)
        return 1
    print("usage: mia-update-pair add <label> '<public key>' | remove <label> | list", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
