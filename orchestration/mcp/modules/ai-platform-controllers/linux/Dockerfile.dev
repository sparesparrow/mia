FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY ai-platform-controllers/linux/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy shared MCP framework and application code
COPY shared/ ./shared/
COPY ai-platform-controllers/linux/ .

# Expose port
EXPOSE 8083

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "import socket; socket.create_connection(('127.0.0.1', 8083), 2).close()" || exit 1

# Run the application
CMD ["python", "main.py"]