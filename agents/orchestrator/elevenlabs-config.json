{
  "conversation_config": {
    "agent": {
      "prompt": {
        "prompt": "",
        "llm": "claude-3-5-sonnet",
        "temperature": 0.9
      },
      "first_message": "*adjusts cat on shoulder* Ah, you've arrived! Emperor Octavius and I were just finishing a concerto in D minor about your task backlog. Movement three was particularly devastating. So — what chaos shall we orchestrate today? And please, make it interesting. The cat judges the boring ones.",
      "language": "en"
    },
    "tts": {
      "voice_id": "",
      "model_id": "eleven_turbo_v2_5",
      "voice_settings": {
        "stability": 0.3,
        "similarity_boost": 0.8,
        "style": 0.6,
        "use_speaker_boost": true
      },
      "optimize_streaming_latency": 3
    },
    "turn": {
      "turn_timeout": 7,
      "mode": "turn"
    }
  },
  "platform_settings": {
    "widget": {
      "avatar": {
        "type": "image",
        "url": ""
      },
      "color_overrides": {
        "primary": "#e8a835",
        "text": "#0F172A"
      },
      "feedback_mode": "none",
      "shareable_page_text": "Talk to The Feral Maestro — your chaotically brilliant planning agent"
    }
  },
  "name": "The Feral Maestro",
  "tools": [
    {
      "type": "webhook",
      "name": "control_lights",
      "description": "Control smart home lights — set color and brightness in any room.",
      "api_schema": {
        "url": "",
        "method": "POST",
        "request_body_schema": {
          "type": "object",
          "properties": {
            "tool_name": { "type": "string", "enum": ["control_lights"] },
            "parameters": {
              "type": "object",
              "properties": {
                "color":      { "type": "string", "description": "CSS color name or hex value, e.g. 'blue' or '#0000ff'" },
                "brightness": { "type": "number", "minimum": 0, "maximum": 100, "description": "Brightness percentage 0–100" },
                "room":       { "type": "string", "description": "Room name, e.g. 'living room'" }
              },
              "required": ["color"]
            }
          },
          "required": ["tool_name", "parameters"]
        }
      }
    },
    {
      "type": "webhook",
      "name": "git_operation",
      "description": "Run a read-only git command (status, diff, log, branch) on the MIA repository.",
      "api_schema": {
        "url": "",
        "method": "POST",
        "request_body_schema": {
          "type": "object",
          "properties": {
            "tool_name": { "type": "string", "enum": ["git_operation"] },
            "parameters": {
              "type": "object",
              "properties": {
                "operation": { "type": "string", "enum": ["status", "diff", "log", "branch"], "description": "Git subcommand" },
                "args":      { "type": "array", "items": { "type": "string" }, "description": "Additional flags" }
              },
              "required": ["operation"]
            }
          },
          "required": ["tool_name", "parameters"]
        }
      }
    },
    {
      "type": "webhook",
      "name": "deploy_service",
      "description": "Request deployment of a MIA microservice.",
      "api_schema": {
        "url": "",
        "method": "POST",
        "request_body_schema": {
          "type": "object",
          "properties": {
            "tool_name": { "type": "string", "enum": ["deploy_service"] },
            "parameters": {
              "type": "object",
              "properties": {
                "service":     { "type": "string", "description": "Service name, e.g. 'mia-api'" },
                "environment": { "type": "string", "enum": ["dev", "staging", "prod"], "description": "Target environment" }
              },
              "required": ["service"]
            }
          },
          "required": ["tool_name", "parameters"]
        }
      }
    },
    {
      "type": "webhook",
      "name": "read_file",
      "description": "Read a file from the MIA project (read-only, within project root).",
      "api_schema": {
        "url": "",
        "method": "POST",
        "request_body_schema": {
          "type": "object",
          "properties": {
            "tool_name": { "type": "string", "enum": ["read_file"] },
            "parameters": {
              "type": "object",
              "properties": {
                "path": { "type": "string", "description": "File path relative to project root" }
              },
              "required": ["path"]
            }
          },
          "required": ["tool_name", "parameters"]
        }
      }
    }
  ]
}
