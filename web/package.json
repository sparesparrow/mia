{
  "name": "mia-web",
  "version": "1.0.0",
  "description": "MIA Web Pages Generator",
  "main": "scripts/generatePages.js",
  "scripts": {
    "build": "node scripts/generatePages.js",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean",
    "serve": "node -e \"const h=require('http'),f=require('fs'),p=require('path'),d=p.resolve('dist'),mt={'.html':'text/html;charset=utf-8','.css':'text/css','.js':'application/javascript','.yaml':'text/yaml','.png':'image/png','.jpg':'image/jpeg','.svg':'image/svg+xml','.mp3':'audio/mpeg'};h.createServer((q,r)=>{let u=decodeURIComponent(q.url.split('?')[0]);if(u==='/')u='/index.html';let fp=p.join(d,u);if(f.existsSync(fp)&&f.statSync(fp).isDirectory())fp=p.join(fp,'index.html');f.readFile(fp,(e,b)=>{if(e){r.writeHead(404);return r.end('404 '+u)}r.writeHead(200,{'content-type':mt[p.extname(fp)]||'application/octet-stream'});r.end(b)})}).listen(8080,()=>console.log('serving dist/ on http://localhost:8080'))\"",
    "test": "node scripts/build-smoke.js",
    "pretest": "npm run build"
  },
  "engines": {
    "node": ">=14.14"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {},
  "keywords": [
    "mia",
    "web",
    "templating",
    "i18n"
  ],
  "author": "MIA Team",
  "license": "MIT"
}
