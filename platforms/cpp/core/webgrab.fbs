namespace webgrab;

table DownloadRequest {
  url:string;
}

table DownloadResponse {
  sessionId:uint32;
}

table DownloadStatusRequest {
  sessionId:uint32;
}

table DownloadStatusResponse {
  status:string;
}

table DownloadAbortRequest {
  sessionId:uint32;
}

table ShutdownRequest {
}

// GPIO Control Messages
table GPIOConfigureRequest {
  pin:int32;
  direction:string; // "input" or "output"
}

table GPIOSetRequest {
  pin:int32;
  value:bool;
}

table GPIOGetRequest {
  pin:int32;
}

table GPIOStatusRequest {
}

table GPIOConfigureResponse {
  pin:int32;
  success:bool;
}

table GPIOSetResponse {
  pin:int32;
  success:bool;
}

table GPIOGetResponse {
  pin:int32;
  value:bool;
  success:bool;
}

table GPIOStatusResponse {
  pins:[GPIOPinStatus];
}

table GPIOPinStatus {
  pin:int32;
  direction:string;
  value:bool;
}

// MQTT Transport Envelope
table MQTTMessage {
  topic:string;
  payload:string;  // JSON payload
  qos:int32 = 0;
  retain:bool = false;
}

table ErrorResponse {
  error:string;
}

// Enhanced unions for MQTT + legacy support
union Request {
  DownloadRequest,
  DownloadStatusRequest,
  DownloadAbortRequest,
  ShutdownRequest,
  GPIOConfigureRequest,
  GPIOSetRequest,
  GPIOGetRequest,
  GPIOStatusRequest,
  SystemStatusRequest,
  DeviceDiscoveryRequest,
  TelemetryRequest,
  CommandAckRequest,
  HealthCheckRequest
}

union Response {
  DownloadResponse,
  DownloadStatusResponse,
  ErrorResponse,
  GPIOConfigureResponse,
  GPIOSetResponse,
  GPIOGetResponse,
  GPIOStatusResponse,
  SystemStatusResponse,
  DeviceDiscoveryResponse,
  TelemetryResponse,
  CommandAckResponse,
  HealthCheckResponse
}

table Message {
  request:Request;
  response:Response;
}

// System Status Messages
table SystemStatusRequest {
}

table SystemStatusResponse {
  uptime_seconds:uint64;
  memory_used_mb:uint32;
  memory_total_mb:uint32;
  cpu_usage_percent:float;
  active_devices:uint32;
  timestamp:uint64;
}

// Device Management Messages
table DeviceDiscoveryRequest {
  device_type:string;  // optional filter
}

table DeviceInfo {
  device_id:string;
  device_type:string;
  capabilities:[string];
  status:string;  // "online", "offline", "error"
  last_seen:uint64;
  metadata:[DeviceMetadata];
}

table DeviceMetadata {
  key:string;
  value:string;
}

table DeviceDiscoveryResponse {
  devices:[DeviceInfo];
}

// Telemetry Messages
table TelemetryRequest {
  device_id:string;  // optional specific device
  sensor_type:string;  // optional filter
}

table SensorReading {
  sensor_id:string;
  sensor_type:string;
  value:float;
  unit:string;
  timestamp:uint64;
  metadata:[DeviceMetadata];
}

table TelemetryResponse {
  device_id:string;
  readings:[SensorReading];
}

// Command Acknowledgment
table CommandAckRequest {
  command_id:string;
}

table CommandAckResponse {
  command_id:string;
  success:bool;
  message:string;
  timestamp:uint64;
}

// Service Health Messages
table HealthCheckRequest {
  service_name:string;
}

table ServiceHealth {
  service_name:string;
  status:string;  // "healthy", "degraded", "unhealthy"
  uptime_seconds:uint64;
  last_check:uint64;
  error_message:string;
}

table HealthCheckResponse {
  services:[ServiceHealth];
  overall_status:string;
}

// MQTT-specific envelope for cross-process communication
table MQTTEnvelope {
  message_id:string;
  timestamp:uint64;
  source:string;     // "python-orchestrator", "cpp-hardware-server", etc.
  target:string;     // target service identifier
  payload:Message;   // the actual message content
}

// Root types for serialization
root_type DownloadRequest;
root_type DownloadResponse;
root_type DownloadStatusRequest;
root_type DownloadStatusResponse;
root_type DownloadAbortRequest;
root_type ShutdownRequest;
root_type ErrorResponse;
root_type Message;

// Additional root types for new messages
root_type SystemStatusRequest;
root_type SystemStatusResponse;
root_type DeviceDiscoveryRequest;
root_type DeviceDiscoveryResponse;
root_type TelemetryRequest;
root_type TelemetryResponse;
root_type CommandAckRequest;
root_type CommandAckResponse;
root_type HealthCheckRequest;
root_type HealthCheckResponse;