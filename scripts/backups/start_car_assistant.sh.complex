#!/bin/bash

# Mobile Intelligent Assistant (MIA) - Car Assistant Startup Script
# Enhanced with MCP-Prompts Integration
# This script starts all required services for the car assistant agent with AI-powered prompt management

set -euo pipefail

# Enhanced logging & error handling
LOG_DIR="${MIA_LOG_DIR:-/var/log/mia}"
PROMPT_CACHE="${MIA_PROMPT_CACHE:-/tmp/mia-prompts.json}"

mkdir -p "$LOG_DIR"

log_info() { echo "[$(date +'%Y-%m-%d %H:%M:%S')] INFO: $*" | tee -a "$LOG_DIR/mia.log"; }
log_error() { echo "[$(date +'%Y-%m-%d %H:%M:%S')] ERROR: $*" | tee -a "$LOG_DIR/mia.log" >&2; }

echo "🚗 Starting Mobile Intelligent Assistant (MIA) - Car Assistant with MCP-Prompts"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to check if a port is available
check_port() {
    local port=$1
    local service=$2
    if lsof -Pi :$port -sTCP:LISTEN -t >/dev/null ; then
        echo -e "${GREEN}✓${NC} $service is running on port $port"
        return 0
    else
        echo -e "${RED}✗${NC} $service is not running on port $port"
        return 1
    fi
}

# Function to start a service in background
start_service() {
    local name=$1
    local command=$2
    local logfile=$3

    echo -e "${BLUE}Starting $name...${NC}"
    if [ -n "$logfile" ]; then
        $command > "$logfile" 2>&1 &
        echo $! > "${name}.pid"
        echo -e "${GREEN}✓${NC} $name started (PID: $!, logs: $logfile)"
    else
        $command &
        echo $! > "${name}.pid"
        echo -e "${GREEN}✓${NC} $name started (PID: $!)"
    fi
}

# ==============================================================================
# SECTION 1: MCP-PROMPTS BOOTSTRAP
# ==============================================================================

bootstrap_mcp_prompts() {
    log_info "Bootstrapping mcp-prompts server..."

    # Check if mcp-prompts is available
    if ! command -v npx &>/dev/null; then
        log_error "npx not found. Installing Node.js..."
        # Auto-install Node.js if needed
        # Installation logic here
    fi

    # Start mcp-prompts server in background
    export PROMPTS_DIR="${PROMPTS_DIR:-/home/sparrow/mcp/data/prompts}"
    export MCP_PROMPTS_PORT=9001

    npx -y @sparesparrow/mcp-prompts --port $MCP_PROMPTS_PORT \
        > "$LOG_DIR/mcp-prompts.log" 2>&1 &

    MCP_PROMPTS_PID=$!
    echo $MCP_PROMPTS_PID > /tmp/mcp-prompts.pid

    # Wait for server to be ready
    sleep 3
    if ! kill -0 $MCP_PROMPTS_PID 2>/dev/null; then
        log_error "Failed to start mcp-prompts server"
        return 1
    fi

    log_info "mcp-prompts server started (PID: $MCP_PROMPTS_PID)"
}

# ==============================================================================
# SECTION 2: PROMPT CACHE MANAGER (Inline Python)
# ==============================================================================

create_prompt_cache_worker() {
    # Create prompt cache manager worker
    cat > /tmp/mia_prompt_cache_worker.py << 'EOF'
#!/usr/bin/env python3
"""
MIA Prompt Cache Manager
Handles prompt fetching, caching, and variable substitution
"""

import asyncio
import json
import logging
from pathlib import Path
from typing import Dict, Any, Optional
from datetime import datetime, timedelta
import sys

# Setup logging
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s'
)
logger = logging.getLogger("PromptCacheWorker")

class PromptCacheManager:
    """Manages prompt caching and variable substitution"""

    def __init__(self, cache_file: str = "/tmp/mia-prompts.json"):
        self.cache_file = Path(cache_file)
        self.cache: Dict[str, Dict[str, Any]] = {}
        self.cache_ttl = timedelta(hours=1)
        self.load_cache()

    def load_cache(self):
        """Load prompts from cache file"""
        if self.cache_file.exists():
            try:
                with open(self.cache_file) as f:
                    self.cache = json.load(f)
                logger.info(f"Loaded {len(self.cache)} prompts from cache")
            except Exception as e:
                logger.warning(f"Failed to load cache: {e}")

    def save_cache(self):
        """Save prompts to cache file"""
        try:
            with open(self.cache_file, 'w') as f:
                json.dump(self.cache, f, indent=2)
            logger.info(f"Saved {len(self.cache)} prompts to cache")
        except Exception as e:
            logger.error(f"Failed to save cache: {e}")

    def get_prompt(self, prompt_id: str, variables: Optional[Dict[str, str]] = None) -> Optional[str]:
        """Get and render a prompt"""
        if prompt_id not in self.cache:
            logger.warning(f"Prompt not found: {prompt_id}")
            return None

        prompt_data = self.cache[prompt_id]
        content = prompt_data.get("content", "")

        # Variable substitution
        if variables:
            for key, value in variables.items():
                content = content.replace(f"{{{{{key}}}}}", str(value))

        return content

    def cache_prompt(self, prompt_id: str, prompt_data: Dict[str, Any]):
        """Cache a prompt"""
        self.cache[prompt_id] = {
            **prompt_data,
            "cached_at": datetime.now().isoformat()
        }
        self.save_cache()
        logger.info(f"Cached prompt: {prompt_id}")

async def main():
    """Main entry point"""
    manager = PromptCacheManager()

    # Example: Load MIA-specific prompts
    mia_prompts_dir = Path("/opt/mia/prompts")
    if mia_prompts_dir.exists():
        for prompt_file in mia_prompts_dir.glob("*.json"):
            try:
                with open(prompt_file) as f:
                    prompt_data = json.load(f)
                    manager.cache_prompt(prompt_data["id"], prompt_data)
            except Exception as e:
                logger.error(f"Failed to load {prompt_file}: {e}")

    logger.info("Prompt cache manager ready")

    # Keep running
    await asyncio.sleep(float('inf'))

if __name__ == "__main__":
    asyncio.run(main())
EOF

    chmod +x /tmp/mia_prompt_cache_worker.py
}

# ==============================================================================
# SECTION 3: ENHANCED GPIO WORKER WITH PROMPT INTEGRATION
# ==============================================================================

create_gpio_worker_with_prompts() {
    cat > /tmp/mia_gpio_worker.py << 'EOF'
#!/usr/bin/env python3
"""
MIA GPIO Worker with Prompt-Driven Configuration
"""

import json
import logging
import time
from pathlib import Path
from typing import Dict, Any, Optional

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger("GPIOWorker")

class PromptDrivenGPIOWorker:
    """GPIO worker that uses prompts for configuration"""

    def __init__(self, prompt_cache_file: str = "/tmp/mia-prompts.json"):
        self.prompt_cache = {}
        self.load_prompt_cache(prompt_cache_file)
        self.gpio_config = self._get_gpio_config_from_prompts()

    def load_prompt_cache(self, cache_file: str):
        """Load cached prompts"""
        if Path(cache_file).exists():
            with open(cache_file) as f:
                self.prompt_cache = json.load(f)

    def _get_gpio_config_from_prompts(self) -> Dict[str, Any]:
        """Extract GPIO configuration from prompts"""
        gpio_prompt = self.prompt_cache.get("mia-gpio-config", {})

        # Parse configuration from prompt content
        config = {
            "led_pins": [17, 27, 22],
            "button_pins": [23, 24],
            "sensor_pins": [25, 26],
        }

        logger.info(f"GPIO config loaded: {config}")
        return config

    def initialize_pins(self):
        """Initialize GPIO pins"""
        try:
            import RPi.GPIO as GPIO
            GPIO.setmode(GPIO.BCM)

            for pin in self.gpio_config.get("led_pins", []):
                GPIO.setup(pin, GPIO.OUT)

            logger.info("GPIO pins initialized")
            return True
        except Exception as e:
            logger.error(f"GPIO initialization failed: {e}")
            return False

    def control_light(self, pin: int, state: str):
        """Control light (on/off)"""
        try:
            import RPi.GPIO as GPIO
            gpio_state = GPIO.HIGH if state.lower() == "on" else GPIO.LOW
            GPIO.output(pin, gpio_state)
            logger.info(f"GPIO {pin} set to {state}")
        except Exception as e:
            logger.error(f"Failed to control GPIO {pin}: {e}")

    def cleanup(self):
        """Cleanup GPIO"""
        try:
            import RPi.GPIO as GPIO
            GPIO.cleanup()
            logger.info("GPIO cleanup complete")
        except Exception as e:
            logger.error(f"GPIO cleanup failed: {e}")

if __name__ == "__main__":
    worker = PromptDrivenGPIOWorker()
    worker.initialize_pins()

    # Example: Flash lights
    for i in range(3):
        worker.control_light(17, "on")
        time.sleep(1)
        worker.control_light(17, "off")
        time.sleep(1)

    worker.cleanup()
EOF

chmod +x /tmp/mia_gpio_worker.py
}

# ==============================================================================
# SECTION 4: ENHANCED OBD WORKER WITH DIAGNOSTIC PROMPTS
# ==============================================================================

create_obd_worker_with_prompts() {
    cat > /tmp/mia_obd_worker.py << 'EOF'
#!/usr/bin/env python3
"""
MIA OBD-II Worker with Diagnostic Prompt Integration
"""

import json
import logging
import asyncio
from typing import Dict, Any, Optional
from pathlib import Path

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger("OBDWorker")

class PromptDrivenOBDWorker:
    """OBD worker that uses diagnostic prompts"""

    def __init__(self, prompt_cache_file: str = "/tmp/mia-prompts.json"):
        self.prompt_cache = {}
        self.vehicle_data = {}
        self.load_prompt_cache(prompt_cache_file)

    def load_prompt_cache(self, cache_file: str):
        """Load cached prompts"""
        if Path(cache_file).exists():
            with open(cache_file) as f:
                self.prompt_cache = json.load(f)

    def read_obd_data(self) -> Dict[str, Any]:
        """Read OBD-II data"""
        # Simulated OBD data
        data = {
            "rpm": 2500,
            "speed": 65,
            "fuel_level": 75,
            "temperature": 95,
            "error_codes": []
        }

        logger.info(f"OBD data: {data}")
        return data

    def get_diagnostic_prompt(self, obd_data: Dict[str, Any]) -> Optional[str]:
        """Get diagnostic prompt for current OBD state"""
        diagnostic_prompt = self.prompt_cache.get("mia-car-diagnostic-analysis", {})

        if not diagnostic_prompt:
            logger.warning("Diagnostic prompt not found in cache")
            return None

        content = diagnostic_prompt.get("content", "")

        # Substitute variables
        variables = {
            "obd_pids": json.dumps(obd_data),
            "error_codes": ",".join(obd_data.get("error_codes", [])),
            "vehicle_model": "Citroën C4",
            "mileage": 45000
        }

        for key, value in variables.items():
            content = content.replace(f"{{{{{key}}}}}", str(value))

        return content

    async def analyze_diagnostics(self):
        """Analyze vehicle diagnostics using prompts"""
        obd_data = self.read_obd_data()
        diagnostic_prompt = self.get_diagnostic_prompt(obd_data)

        if diagnostic_prompt:
            logger.info("Diagnostic analysis:")
            logger.info(diagnostic_prompt[:200] + "...")
            return True

        return False

if __name__ == "__main__":
    worker = PromptDrivenOBDWorker()
    asyncio.run(worker.analyze_diagnostics())
EOF

chmod +x /tmp/mia_obd_worker.py
}

