[Unit]
Description=MIA Citroën OBD-II Telemetry Bridge
Documentation=https://github.com/sparesparrow/ai-servis/docs/automotive/citroen-integration.md
After=network.target zmq-broker.service
Wants=zmq-broker.service

[Service]
Type=simple
User=mia
Group=dialout
WorkingDirectory=/opt/mia/orchestration/mcp/modules/citroen-c4-bridge
Environment=ELM_SERIAL_PORT=/dev/ttyUSB0
Environment=ELM_BAUD_RATE=38400
Environment=ZMQ_PUB_PORT=5557
Environment=PYTHONPATH=/opt/mia/apps/rpi-backend/py-api:/opt/mia
ExecStart=/opt/mia/venv/bin/python3 /opt/mia/orchestration/mcp/modules/citroen-c4-bridge/main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mia-citroen-bridge
MemoryMax=256M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
