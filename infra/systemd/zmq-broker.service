[Unit]
Description=MIA ZeroMQ Message Broker
After=network.target
Before=mia-api.service mia-gpio-worker.service

[Service]
Type=simple
User=mia
Group=mia
WorkingDirectory=/opt/mia/apps/rpi-backend/shared/messaging
ExecStart=/opt/mia/venv/bin/python3 /opt/mia/apps/rpi-backend/shared/messaging/broker.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment=PYTHONPATH=/opt/mia/apps/rpi-backend/py-api

[Install]
WantedBy=multi-user.target
