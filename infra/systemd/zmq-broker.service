[Unit]
Description=MIA ZeroMQ Message Broker
After=network.target
Before=mia-api.service mia-gpio-worker.service

[Service]
Type=simple
User=mia
Group=mia
WorkingDirectory=/opt/mia/apps/rpi-backend/shared/messaging
EnvironmentFile=-/etc/mia/environment
ExecStart=/bin/bash -c 'exec "$${MIA_PYTHON:-/usr/local/bin/mia-python}" /opt/mia/apps/rpi-backend/shared/messaging/broker.py'
Restart=always
WatchdogSec=0
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment=PYTHONPATH=/opt/mia/apps/rpi-backend/py-api

[Install]
WantedBy=multi-user.target
