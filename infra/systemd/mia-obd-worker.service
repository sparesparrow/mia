[Unit]
Description=MIA OBD Worker - ELM327 Simulator Service
After=network.target zmq-broker.service mia-serial-bridge.service
Wants=zmq-broker.service mia-serial-bridge.service

[Service]
Type=simple
User=mia
Group=mia
WorkingDirectory=/opt/mia/apps/rpi-backend/py-api
ExecStart=/opt/mia/venv/bin/python3 services/obd_worker.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment=PYTHONPATH=/opt/mia/apps/rpi-backend/py-api

[Install]
WantedBy=multi-user.target
