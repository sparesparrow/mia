[Unit]
Description=MIA GPIO Worker
After=network.target zmq-broker.service
Wants=zmq-broker.service

[Service]
Type=simple
User=mia
Group=mia
WorkingDirectory=/opt/mia/apps/rpi-backend/py-api
ExecStart=/opt/mia/venv/bin/python3 hardware/gpio_worker.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment=PYTHONPATH=/opt/mia/apps/rpi-backend/py-api

[Install]
WantedBy=multi-user.target
