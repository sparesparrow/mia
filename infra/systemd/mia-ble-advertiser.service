[Unit]
Description=MIA BLE Advertiser Service - Makes RPi discoverable as OBD-II adapter
After=network.target bluetooth.service
Requires=bluetooth.service

[Service]
Type=simple
User=mia
Group=mia
WorkingDirectory=/opt/mia/apps/rpi-backend/py-api
ExecStart=/opt/mia/venv/bin/python3 services/ble_advertiser.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment=PYTHONPATH=/opt/mia/apps/rpi-backend/py-api

# Capabilities for Bluetooth
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
