[Unit]
Description=MIA LED Monitor Service - AI Service Status Monitor
After=network.target zmq-broker.service
Wants=zmq-broker.service

[Service]
Type=simple
User=mia
Group=mia
WorkingDirectory=/opt/mia/apps/rpi-backend/py-api
ExecStart=/opt/mia/venv/bin/python3 services/led_monitor_service.py --broker-url tcp://localhost:5555 --telemetry-url tcp://localhost:5556 --led-port /dev/ttyUSB0
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONPATH=/opt/mia/apps/rpi-backend/py-api

[Install]
WantedBy=multi-user.target
