[Unit]
Description=MIA USB Camera Service
After=network.target zmq-broker.service
Wants=zmq-broker.service

[Service]
Type=simple
User=mia
Group=mia
WorkingDirectory=/opt/mia/apps/rpi-backend/py-api
ExecStart=/opt/mia/venv/bin/python3 services/usb_camera_service.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment=PYTHONPATH=/opt/mia/apps/rpi-backend/py-api
# Camera device permissions
SupplementaryGroups=video plugdev
# USB device access
Environment=UDEV=1

[Install]
WantedBy=multi-user.target
